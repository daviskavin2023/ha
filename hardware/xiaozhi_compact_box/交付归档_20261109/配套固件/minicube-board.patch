@@ -0,0 +1,21 @@
+menu "MiniCube TK020F1131 PB panel"
+    depends on BOARD_TYPE_XIAOZHI_MINICUBE
+
+config MINICUBE_LCD_HEIGHT
+    int "Visible panel height (verify with vendor/test pattern)"
+    range 240 320
+    default 296
+
+config MINICUBE_LCD_OFFSET_Y
+    int "ST7789 vertical RAM offset"
+    range 0 80
+    default 0
+
+config MINICUBE_TOUCH_POLL
+    bool "Poll CST816x over I2C without using unidentified INT/RST pads"
+    default y
+    help
+        Probe 0x15 and read registers without writing reset or sleep registers.
+        A timeout is reported as a touch error, not a fabricated release event.
+        Actual CST816D operation on this adapter still requires hardware testing.
+endmenu
diff --git a/main/boards/xiaozhi-minicube/README.md b/main/boards/xiaozhi-minicube/README.md
new file mode 100644
index 0000000..fb7b5be
--- /dev/null
+++ b/main/boards/xiaozhi-minicube/README.md
@@ -0,0 +1,34 @@
+# XiaoZhi MiniCube / TK020F1131_PB
+
+Unique board identity: `xiaozhi-minicube`; release variant:
+`xiaozhi-minicube-tk020-pb`. ESP32-S3 N16R8, 16MB flash / octal PSRAM.
+
+Pins follow the v3.1 carrier. Microphone: DIN4/WS5/SCK6. PCM5102A:
+BCK7/LRCK15/DATA16. PAM8302A SD9, active high. Display:
+MOSI12/DC10/SCK11/CS13. Touch: SDA2/SCL1. Radar OUT8 is read only;
+UART17/18 remain reserved for radar and are not reused by a generic lamp tool.
+
+Required audio hardware: PATCH-A01 15k/1k passive attenuator and input coupling.
+The firmware does not claim an arbitrary digital volume guarantees no clipping.
+SD is low during startup/disabled playback and enabled asynchronously 10ms after
+the I2S output is enabled. This is not an AUX insertion detector.
+
+Only the two labeled 4P connectors are used. BL/RST/INT solder points are not
+driven. The ST7789 uses its software-reset command. CST816x is probed at 0x15
+and polled via the same register layout used by the upstream CST816D board.
+Read failures are logged and never treated as a release event. A matching
+controller/batch and proper I2C pullups must be verified on actual hardware.
+The driver's weak internal pullups do not establish production signal margins.
+
+The 240x296, y-offset=0 display profile is an initial unverified BOM profile,
+not a vendor-confirmed resolution/offset. Both height and offset are configurable
+through Kconfig. Compilation cannot prove that these values fit the actual glass.
+
+Build with ESP-IDF 6.1 using:
+
+```
+python3 scripts/build.py xiaozhi-minicube --name xiaozhi-minicube-tk020-pb
+```
+
+No flashing is performed by adding/building this board. Confirm the carrier,
+power topology, wiring and panel profile before installing any image.
diff --git a/main/boards/xiaozhi-minicube/config.h b/main/boards/xiaozhi-minicube/config.h
new file mode 100644
index 0000000..8c3d5ee
--- /dev/null
+++ b/main/boards/xiaozhi-minicube/config.h
@@ -0,0 +1,48 @@
+#pragma once
+
+#include <driver/gpio.h>
+#include "sdkconfig.h"
+
+// These assignments follow the actual carrier nets, not the stock breadboard.
+#define AUDIO_INPUT_SAMPLE_RATE 16000
+#define AUDIO_OUTPUT_SAMPLE_RATE 24000
+#define MIC_DATA_PIN GPIO_NUM_4
+#define MIC_WS_PIN GPIO_NUM_5
+#define MIC_SCK_PIN GPIO_NUM_6
+#define DAC_BCK_PIN GPIO_NUM_7
+#define DAC_LRCK_PIN GPIO_NUM_15
+#define DAC_DATA_PIN GPIO_NUM_16
+#define AMP_SD_PIN GPIO_NUM_9
+#define RADAR_OUT_PIN GPIO_NUM_8
+#define TOUCH_SCL_PIN GPIO_NUM_1
+#define TOUCH_SDA_PIN GPIO_NUM_2
+#define DISPLAY_MOSI_PIN GPIO_NUM_12
+#define DISPLAY_DC_PIN GPIO_NUM_10
+#define DISPLAY_CLK_PIN GPIO_NUM_11
+#define DISPLAY_CS_PIN GPIO_NUM_13
+#define BOOT_BUTTON_GPIO GPIO_NUM_0
+
+// Eight-wire panel: do not drive unidentified BL/RST/INT solder pads.
+#define DISPLAY_RST_PIN GPIO_NUM_NC
+#define DISPLAY_BACKLIGHT_PIN GPIO_NUM_NC
+#define DISPLAY_WIDTH 240
+#define DISPLAY_HEIGHT CONFIG_MINICUBE_LCD_HEIGHT
+#define DISPLAY_OFFSET_X 0
+#define DISPLAY_OFFSET_Y CONFIG_MINICUBE_LCD_OFFSET_Y
+
+#if DISPLAY_HEIGHT + DISPLAY_OFFSET_Y > 320
+#error "MiniCube display height plus offset exceeds ST7789 RAM height"
+#endif
+
+// This profile excludes PSRAM, UART0, USB, strap and optional solder-pad pins.
+constexpr int kMinicubeFunctionalPins[] = {4, 5, 6, 7, 15, 16, 9, 8, 1, 2, 12, 10, 11, 13};
+constexpr bool MinicubePinsAreDistinct() {
+    for (unsigned i = 0; i < sizeof(kMinicubeFunctionalPins) / sizeof(int); ++i) {
+        for (unsigned j = i + 1; j < sizeof(kMinicubeFunctionalPins) / sizeof(int); ++j) {
+            if (kMinicubeFunctionalPins[i] == kMinicubeFunctionalPins[j])
+                return false;
+        }
+    }
+    return true;
+}
+static_assert(MinicubePinsAreDistinct(), "MiniCube functional GPIO conflict");
