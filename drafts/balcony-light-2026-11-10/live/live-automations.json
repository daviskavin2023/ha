{
 "auto_lighting_self_healing_patrol": {
  "id": "auto_lighting_self_healing_patrol",
  "alias": "全屋灯光自主巡检与幽灵灯自愈引擎",
  "description": "全屋5分钟极速自愈巡检看门狗：全天候扫描客厅、厨房、卫浴、走廊、书房、阳台及所有卧室，彻底消灭假死、丢包、雷达风扇误报导致的长亮不灭问题 [工业级一劳永逸版]；2026-11-10：客厅占用接入HB01+USB LD2410融合，失效不作无人；原场景门控和动作保留",
  "triggers": [
   {
    "minutes": "/5",
    "platform": "time_pattern"
   }
  ],
  "conditions": [
   {
    "condition": "state",
    "entity_id": "input_boolean.hui_ke_mo_shi",
    "state": "off",
    "alias": "3051 会客中不动作"
   }
  ],
  "actions": [
   {
    "if": [
     {
      "condition": "and",
      "conditions": [
       {
        "condition": "or",
        "conditions": [
         {
          "condition": "state",
          "entity_id": "switch.bean_cn_1122794638_blns1_on_p_2_1",
          "state": "on"
         },
         {
          "condition": "state",
          "entity_id": "switch.bean_cn_1117205015_blns3_on_p_3_1",
          "state": "on"
         },
         {
          "condition": "and",
          "conditions": [
           {
            "condition": "state",
            "entity_id": "sun.sun",
            "state": "below_horizon"
           },
           {
            "above": 40,
            "condition": "numeric_state",
            "entity_id": "sensor.linp_cn_1134456435_hb01_illumination_p_2_5"
           }
          ]
         }
        ]
       },
       {
        "condition": "state",
        "entity_id": "binary_sensor.linp_cn_1134456435_hb01_occupancy_status_p_2_1",
        "state": "off"
       },
       {
        "above": 2,
        "condition": "numeric_state",
        "entity_id": "sensor.linp_cn_1134456435_hb01_no_one_duration_p_2_4"
       },
       {
        "condition": "or",
