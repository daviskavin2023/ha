    }
   }
  ],
  "conditions": [
   {
    "condition": "state",
    "entity_id": "switch.lemesh_cn_888711197_sw1f11_on_p_2_1",
    "state": "on"
   },
   {
    "condition": "or",
    "conditions": [
     {
      "condition": "and",
      "conditions": [
       {
        "condition": "trigger",
        "id": "ghost_cancel_35s"
       },
       {
        "condition": "state",
        "entity_id": "binary_sensor.linp_cn_blt_3_1kn1n1huoc800_es2_occupancy_status_p_2_1078",
        "state": "off"
       }
      ]
     },
     {
      "condition": "and",
      "conditions": [
       {
        "condition": "trigger",
        "id": "radar_clear_1m"
       },
       {
        "condition": "template",
        "value_template": "{{ states('sensor.linp_cn_blt_3_1k0m2afv4cg01_hs1bb2_no_motion_duration_p_2_1024') | int(0) >= 60 }}"
       }
      ]
     },
     {
      "condition": "and",
      "conditions": [
       {
        "condition": "trigger",
        "id": "pir_no_motion_2m"
       },
       {
        "condition": "state",
        "entity_id": "binary_sensor.linp_cn_blt_3_1kn1n1huoc800_es2_occupancy_status_p_2_1078",
        "state": "off"
       }
      ]
     },
     {
      "condition": "trigger",
      "id": "anti_clutter_pir_5m"
     },
     {
      "condition": "and",
      "conditions": [
       {
        "condition": "trigger",
        "id": "safety_cap_6m"
       },
       {
        "condition": "template",
        "value_template": "{{ states('sensor.linp_cn_blt_3_1k0m2afv4cg01_hs1bb2_no_motion_duration_p_2_1024') | int(0) >= 120 }}"
       }
      ]
     }
    ]
   }
  ],
