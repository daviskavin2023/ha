 "1736918907451": {
  "id": "1736918907451",
  "alias": "阳台开灯",
  "description": "阳台暗光(照度<35Lux或日落后)且人从客厅穿过门槛进入阳台秒开灯；白天阴暗暴雨天均能正常感应；2026-11-10：客厅占用接入HB01+USB LD2410融合，失效不作无人；原场景门控和动作保留",
  "triggers": [
   {
    "platform": "state",
    "entity_id": "event.linp_cn_blt_3_1k0m2afv4cg01_hs1bb2_motion_detected_e_2_1008"
   },
   {
    "platform": "numeric_state",
    "entity_id": "sensor.linp_cn_blt_3_1k0m2afv4cg01_hs1bb2_no_motion_duration_p_2_1024",
    "below": 2
   }
  ],
  "conditions": [
   {
    "condition": "state",
    "entity_id": "switch.lemesh_cn_888711197_sw1f11_on_p_2_1",
    "state": "off"
   },
   {
    "condition": "or",
    "conditions": [
     {
      "condition": "state",
      "entity_id": "sun.sun",
      "state": "below_horizon"
     },
     {
      "condition": "numeric_state",
      "entity_id": "sensor.linp_cn_blt_3_1k0m2afv4cg01_hs1bb2_illumination_p_2_1005",
      "below": 35
     }
    ]
   },
   {
    "condition": "or",
    "conditions": [
     {
      "condition": "state",
      "entity_id": "binary_sensor.ke_ting_shuang_lei_da_you_ren",
      "state": "on"
     },
     {
      "condition": "template",
      "value_template": "{{ (now() - states.binary_sensor.ke_ting_shuang_lei_da_you_ren.last_changed).total_seconds() < 180 }}"
     }
    ]
   }
  ],
  "actions": [
   {
    "action": "switch.turn_on",
    "target": {
     "entity_id": "switch.lemesh_cn_888711197_sw1f11_on_p_2_1"
    }
   }
  ],
  "initial_state": true,
  "mode": "restart"
 },
 "1736942757466": {
  "alias": "阳台关灯",
  "id": "1736942757466",
  "description": "阳台关灯防线：35秒无雷达秒灭(防误触/过路)；离去雷达无人关灯；感应2被杂物卡死则5分钟门槛超时熔断；6分钟绝对强制定时兜底",
  "mode": "restart",
  "initial_state": true,
  "triggers": [
   {
    "id": "ghost_cancel_35s",
    "platform": "state",
    "entity_id": "switch.lemesh_cn_888711197_sw1f11_on_p_2_1",
    "to": "on",
    "for": {
     "seconds": 35
    }
   },
   {
    "id": "radar_clear_1m",
