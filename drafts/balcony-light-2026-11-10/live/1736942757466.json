      {
       "condition": "trigger",
       "id": "ghost_cancel_35s"
      },
      {
       "condition": "state",
       "entity_id": "binary_sensor.linp_cn_blt_3_1kn1n1huoc800_es2_occupancy_status_p_2_1078",
       "state": "off"
      }
     ]
    },
    {
     "condition": "and",
     "conditions": [
      {
       "condition": "trigger",
       "id": "radar_clear_1m"
      },
      {
       "condition": "template",
