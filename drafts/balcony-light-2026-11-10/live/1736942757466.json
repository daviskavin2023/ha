{
 "alias": "阳台关灯",
 "id": "1736942757466",
 "description": "阳台关灯防线：35秒无雷达秒灭(防误触/过路)；离去雷达无人关灯；感应2被杂物卡死则5分钟门槛超时熔断；6分钟绝对强制定时兜底",
 "mode": "restart",
 "initial_state": true,
 "triggers": [
  {
   "id": "ghost_cancel_35s",
   "platform": "state",
   "entity_id": "switch.lemesh_cn_888711197_sw1f11_on_p_2_1",
   "to": "on",
   "for": {
    "seconds": 35
   }
  },
  {
   "id": "radar_clear_1m",
   "platform": "state",
   "entity_id": "binary_sensor.linp_cn_blt_3_1kn1n1huoc800_es2_occupancy_status_p_2_1078",
   "to": "off",
   "for": {
    "minutes": 1
   }
  },
  {
   "id": "pir_no_motion_2m",
   "platform": "state",
   "entity_id": "sensor.linp_cn_blt_3_1k0m2afv4cg01_hs1bb2_no_motion_duration_p_2_1024",
   "to": "120"
  },
  {
   "id": "anti_clutter_pir_5m",
   "platform": "state",
   "entity_id": "sensor.linp_cn_blt_3_1k0m2afv4cg01_hs1bb2_no_motion_duration_p_2_1024",
   "to": "300"
  },
  {
   "id": "safety_cap_6m",
   "platform": "state",
   "entity_id": "switch.lemesh_cn_888711197_sw1f11_on_p_2_1",
   "to": "on",
   "for": {
    "minutes": 6
   }
  }
 ],
 "conditions": [
