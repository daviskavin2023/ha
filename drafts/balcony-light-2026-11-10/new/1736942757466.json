{
 "id": "1736942757466",
 "alias": "阳台关灯",
 "description": "2026-11-10 草案：锁存「阳台有人」期间不按时间关；锁存后≥10秒客厅雷达在2.3米内测到走动=人回客厅→60秒后关（期间S04再动或再走动则重新计时/取消）；锁存时S04连续30分钟无动作兜底关；未锁存(手动开/雷达失效开)S04 5分钟无动作关；灯关即清锁存；S13不参与",
 "initial_state": true,
 "mode": "restart",
 "max_exceeded": "silent",
 "triggers": [
  {
   "trigger": "state",
   "entity_id": "sensor.ke_ting_lei_da_jin_chu_zou_dong_shi_jian",
   "not_to": [
    "unknown",
    "unavailable"
   ],
   "id": "exit_walk"
  },
  {
   "trigger": "state",
   "entity_id": "event.linp_cn_blt_3_1k0m2afv4cg01_hs1bb2_motion_detected_e_2_1008",
   "not_to": [
    "unknown",
    "unavailable"
   ],
   "id": "s04_motion"
  },
  {
   "trigger": "template",
   "value_template": "{% set e = states('event.linp_cn_blt_3_1k0m2afv4cg01_hs1bb2_motion_detected_e_2_1008') %}{% set s04 = as_datetime(e) if e not in ['unknown','unavailable'] else none %}{% set ref = [s04, states.switch.lemesh_cn_888711197_sw1f11_on_p_2_1.last_changed] | reject('none') | max %}{{ is_state('switch.lemesh_cn_888711197_sw1f11_on_p_2_1','on') and is_state('input_boolean.yang_tai_you_ren','on') and (now() - ref).total_seconds() >= 1800 }}",
   "id": "latched_30m"
  },
  {
   "trigger": "template",
   "value_template": "{% set e = states('event.linp_cn_blt_3_1k0m2afv4cg01_hs1bb2_motion_detected_e_2_1008') %}{% set s04 = as_datetime(e) if e not in ['unknown','unavailable'] else none %}{% set ref = [s04, states.switch.lemesh_cn_888711197_sw1f11_on_p_2_1.last_changed] | reject('none') | max %}{{ is_state('switch.lemesh_cn_888711197_sw1f11_on_p_2_1','on') and is_state('input_boolean.yang_tai_you_ren','off') and (now() - ref).total_seconds() >= 300 }}",
   "id": "unlatched_5m"
  },
  {
   "trigger": "state",
   "entity_id": "switch.lemesh_cn_888711197_sw1f11_on_p_2_1",
   "to": "off",
   "id": "light_off"
  },
  {
   "trigger": "homeassistant",
   "event": "start",
   "id": "ha_start"
  }
 ],
 "conditions": [
  {
   "condition": "or",
   "conditions": [
    {
     "condition": "and",
     "alias": "回客厅走动：已锁存、灯亮、锁存≥10秒(排除进门那段尾巴)",
     "conditions": [
      {
       "condition": "trigger",
       "id": "exit_walk"
      },
      {
       "condition": "state",
       "entity_id": "input_boolean.yang_tai_you_ren",
       "state": "on"
      },
      {
       "condition": "state",
       "entity_id": "switch.lemesh_cn_888711197_sw1f11_on_p_2_1",
       "state": "on"
      },
      {
       "condition": "template",
       "value_template": "{{ (now() - states.input_boolean.yang_tai_you_ren.last_changed).total_seconds() >= 10 }}"
      }
     ]
    },
    {
     "condition": "and",
     "alias": "S04再动：取消待关",
     "conditions": [
      {
       "condition": "trigger",
       "id": "s04_motion"
      },
      {
       "condition": "state",
       "entity_id": "input_boolean.yang_tai_you_ren",
       "state": "on"
      }
     ]
    },
    {
     "condition": "trigger",
     "id": [
      "latched_30m",
      "unlatched_5m"
     ]
    },
    {
     "condition": "and",
     "conditions": [
      {
       "condition": "trigger",
       "id": [
        "light_off",
        "ha_start"
       ]
      },
      {
       "condition": "state",
       "entity_id": "input_boolean.yang_tai_you_ren",
       "state": "on"
      }
     ]
    }
   ]
  }
 ],
 "actions": [
  {
   "choose": [
    {
     "conditions": [
      {
       "condition": "trigger",
       "id": "exit_walk"
      }
     ],
     "sequence": [
      {
       "delay": {
        "seconds": 60
       }
      },
      {
       "action": "switch.turn_off",
       "target": {
        "entity_id": "switch.lemesh_cn_888711197_sw1f11_on_p_2_1"
       }
      },
      {
       "action": "input_boolean.turn_off",
       "target": {
        "entity_id": "input_boolean.yang_tai_you_ren"
       }
      }
     ]
    },
    {
     "conditions": [
      {
       "condition": "trigger",
       "id": "s04_motion"
      }
     ],
     "sequence": [
      {
       "stop": "S04 有动作，取消待关"
      }
     ]
    },
    {
     "conditions": [
      {
       "condition": "trigger",
       "id": [
        "latched_30m",
        "unlatched_5m"
       ]
      }
     ],
     "sequence": [
      {
       "action": "switch.turn_off",
       "target": {
        "entity_id": "switch.lemesh_cn_888711197_sw1f11_on_p_2_1"
       }
      },
      {
       "action": "input_boolean.turn_off",
       "target": {
        "entity_id": "input_boolean.yang_tai_you_ren"
       }
      }
     ]
    }
   ],
   "default": [
    {
     "if": [
      {
       "condition": "not",
       "conditions": [
        {
         "condition": "state",
         "entity_id": "switch.lemesh_cn_888711197_sw1f11_on_p_2_1",
         "state": "on"
        }
       ]
      }
     ],
     "then": [
      {
       "action": "input_boolean.turn_off",
       "target": {
        "entity_id": "input_boolean.yang_tai_you_ren"
       }
      }
     ]
    }
   ]
  }
 ]
}