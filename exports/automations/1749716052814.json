{
  "id": "1749716052814",
  "alias": "舞台灯联动",
  "description": "舞台人体感应（ES2，原阳台ES2改名）独立控制舞台灯：舞台有人+非观影+暗光（夜间或舞台感应光照度<35lx且<85lx）开灯；舞台无人/观影中/强光关灯；观影期间本自动化完全不动（不自动开也不自动关，允许手动开）；2026-11-20 与厨房、客厅感应解耦，各管各的；会客/生日模式沿用全局屏蔽",
  "triggers": [
    {
      "platform": "state",
      "entity_id": "binary_sensor.linp_cn_blt_3_1kn1n1huoc800_es2_occupancy_status_p_2_1078",
      "to": "on"
    },
    {
      "platform": "state",
      "entity_id": "binary_sensor.linp_cn_blt_3_1kn1n1huoc800_es2_occupancy_status_p_2_1078",
      "to": "off"
    },
    {
      "platform": "state",
      "entity_id": "sensor.linp_cn_blt_3_1kn1n1huoc800_es2_illumination_p_2_1005"
    },
    {
      "platform": "state",
      "entity_id": "input_boolean.ke_ting_guan_ying_mo_shi",
      "to": "on"
    },
    {
      "platform": "state",
      "entity_id": "input_boolean.ke_ting_guan_ying_mo_shi",
      "to": "off"
    },
    {
      "platform": "state",
      "entity_id": "sun.sun"
    }
  ],
  "conditions": [
    {
      "condition": "state",
      "entity_id": "input_boolean.hui_ke_mo_shi",
      "state": "off",
      "alias": "3051 会客中不动作"
    },
    {
      "condition": "state",
      "entity_id": "input_boolean.sheng_ri_mo_shi",
      "state": "off",
      "alias": "3051 生日中不动作"
    },
    {
      "condition": "template",
      "value_template": "{{ states('binary_sensor.linp_cn_blt_3_1kn1n1huoc800_es2_occupancy_status_p_2_1078') in ['on','off'] }}",
      "alias": "舞台感应不可用时不动作"
    }
  ],
  "actions": [
    {
      "choose": [
        {
          "conditions": [
            {
              "condition": "template",
              "value_template": "{% set ill = states('sensor.linp_cn_blt_3_1kn1n1huoc800_es2_illumination_p_2_1005') %}{% set lux = ill | float(999) %}{{ is_state('binary_sensor.linp_cn_blt_3_1kn1n1huoc800_es2_occupancy_status_p_2_1078','on') and is_state('input_boolean.ke_ting_guan_ying_mo_shi','off') and ((is_state('sun.sun','below_horizon') or lux < 35) and lux < 85) }}"
            }
          ],
          "sequence": [
            {
              "action": "switch.turn_on",
              "target": {
                "entity_id": "switch.bean_cn_1124140556_blns2_on_p_2_1"
              }
            }
          ]
        }
      ],
      "default": [
        {
          "if": [
            {
              "condition": "state",
              "entity_id": "input_boolean.ke_ting_guan_ying_mo_shi",
              "state": "off",
              "alias": "观影中不自动关（允许手动开）"
            },
            {
              "condition": "state",
              "entity_id": "switch.bean_cn_1124140556_blns2_on_p_2_1",
              "state": "on"
            }
          ],
          "then": [
            {
              "action": "switch.turn_off",
              "target": {
                "entity_id": "switch.bean_cn_1124140556_blns2_on_p_2_1"
              }
            }
          ]
        }
      ]
    }
  ],
  "initial_state": true,
  "mode": "restart"
}