{"id": "1749716052814", "alias": "舞台灯联动", "description": "舞台雷达（ESP32-C3 LD2410, stage_radar_presence）+ 客厅HB01光照度 控制舞台灯：会客模式强制开、生日模式强制关；平时舞台有人+非观影+（夜间或白天照度<35lx且<85lx）开，舞台无人/观影/白天强光关；夜间不看照度；观影期间不自动开也不自动关、允许手动开；2026-11-21 由 ES2（已下线）迁移至 LD2410 雷达", "triggers": [{"platform": "state", "entity_id": "binary_sensor.stage_radar_presence", "to": "on"}, {"platform": "state", "entity_id": "binary_sensor.stage_radar_presence", "to": "off"}, {"platform": "state", "entity_id": "sensor.linp_cn_1130732284_hb01_illumination_p_2_5"}, {"platform": "state", "entity_id": "input_boolean.ke_ting_guan_ying_mo_shi", "to": "on"}, {"platform": "state", "entity_id": "input_boolean.ke_ting_guan_ying_mo_shi", "to": "off"}, {"platform": "state", "entity_id": "input_boolean.hui_ke_mo_shi"}, {"platform": "state", "entity_id": "input_boolean.sheng_ri_mo_shi"}, {"platform": "state", "entity_id": "sun.sun"}], "conditions": [], "actions": [{"choose": [{"conditions": [{"condition": "state", "entity_id": "input_boolean.hui_ke_mo_shi", "state": "on", "alias": "会客模式：舞台灯强制开"}], "sequence": [{"action": "switch.turn_on", "target": {"entity_id": "switch.bean_cn_1124140556_blns2_on_p_2_1"}}]}, {"conditions": [{"condition": "state", "entity_id": "input_boolean.sheng_ri_mo_shi", "state": "on", "alias": "生日模式：舞台灯强制关"}], "sequence": [{"action": "switch.turn_off", "target": {"entity_id": "switch.bean_cn_1124140556_blns2_on_p_2_1"}}]}, {"conditions": [{"condition": "template", "value_template": "{% set ill = states('sensor.linp_cn_1130732284_hb01_illumination_p_2_5') %}{% set lux = ill | float(999) %}{{ is_state('binary_sensor.stage_radar_presence','on') and is_state('input_boolean.ke_ting_guan_ying_mo_shi','off') and (is_state('sun.sun','below_horizon') or (lux < 35 and lux < 85)) }}"}], "sequence": [{"action": "switch.turn_on", "target": {"entity_id": "switch.bean_cn_1124140556_blns2_on_p_2_1"}}]}], "default": [{"if": [{"condition": "template", "value_template": "{{ states('binary_sensor.stage_radar_presence') in ['on','off'] }}", "alias": "舞台感应不可用时不自动关"}, {"condition": "state", "entity_id": "input_boolean.ke_ting_guan_ying_mo_shi", "state": "off", "alias": "观影中不自动关（允许手动开）"}, {"condition": "state", "entity_id": "switch.bean_cn_1124140556_blns2_on_p_2_1", "state": "on"}], "then": [{"action": "switch.turn_off", "target": {"entity_id": "switch.bean_cn_1124140556_blns2_on_p_2_1"}}]}]}], "initial_state": true, "mode": "restart"}