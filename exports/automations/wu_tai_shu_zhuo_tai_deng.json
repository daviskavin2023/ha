{
  "id": "wu_tai_shu_zhuo_tai_deng",
  "alias": "舞台书桌台灯联动",
  "description": "舞台人体感应(ES2)感应书桌有人→米家台灯2满亮(不限昼夜)；无人持续2分钟→关灯。2026-11-21 新增，感应失联不动作",
  "triggers": [
    {
      "platform": "state",
      "entity_id": "binary_sensor.linp_cn_blt_3_1kn1n1huoc800_es2_occupancy_status_p_2_1078",
      "to": "on"
    },
    {
      "platform": "state",
      "entity_id": "binary_sensor.linp_cn_blt_3_1kn1n1huoc800_es2_occupancy_status_p_2_1078",
      "to": "off",
      "for": {
        "minutes": 2
      }
    }
  ],
  "conditions": [
    {
      "condition": "template",
      "value_template": "{{ states('binary_sensor.linp_cn_blt_3_1kn1n1huoc800_es2_occupancy_status_p_2_1078') in ['on','off'] }}",
      "alias": "舞台感应不可用时不动作"
    }
  ],
  "actions": [
    {
      "choose": [
        {
          "conditions": [
            {
              "condition": "state",
              "entity_id": "binary_sensor.linp_cn_blt_3_1kn1n1huoc800_es2_occupancy_status_p_2_1078",
              "state": "on"
            }
          ],
          "sequence": [
            {
              "action": "light.turn_on",
              "target": {
                "entity_id": "light.xiaomi_cn_2210226837_lamp38_s_2_light"
              },
              "data": {
                "brightness_pct": 100
              }
            }
          ]
        },
        {
          "conditions": [
            {
              "condition": "state",
              "entity_id": "binary_sensor.linp_cn_blt_3_1kn1n1huoc800_es2_occupancy_status_p_2_1078",
              "state": "off"
            }
          ],
          "sequence": [
            {
              "action": "light.turn_off",
              "target": {
                "entity_id": "light.xiaomi_cn_2210226837_lamp38_s_2_light"
              }
            }
          ]
        }
      ]
    }
  ],
  "initial_state": true,
  "mode": "restart"
}