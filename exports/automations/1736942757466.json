      "platform": "state",
      "entity_id": "sensor.linp_cn_blt_3_1k0m2afv4cg01_hs1bb2_no_motion_duration_p_2_1024",
      "to": "300"
    },
    {
      "id": "safety_cap_6m",
      "platform": "state",
      "entity_id": "switch.lemesh_cn_888711197_sw1f11_on_p_2_1",
      "to": "on",
      "for": {
        "minutes": 6
      }
    }
  ],
  "conditions": [
    {
      "condition": "state",
      "entity_id": "switch.lemesh_cn_888711197_sw1f11_on_p_2_1",
      "state": "on"
    },
    {
      "condition": "or",
      "conditions": [
        {
          "condition": "trigger",
          "id": "anti_clutter_pir_5m"
        },
        {
          "condition": "and",
          "conditions": [
            {
              "condition": "trigger",
              "id": "safety_cap_6m"
            },
            {
              "condition": "template",
              "value_template": "{{ states('sensor.linp_cn_blt_3_1k0m2afv4cg01_hs1bb2_no_motion_duration_p_2_1024') | int(0) >= 120 }}"
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "action": "switch.turn_off",
      "target": {
        "entity_id": "switch.lemesh_cn_888711197_sw1f11_on_p_2_1"
      }
    }
  ]
