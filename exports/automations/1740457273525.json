       "id": [
        "fan_normal_check",
        "humidity_recovered",
        "voc_recovered",
        "fan_max_timeout"
       ]
      },
      {
       "condition": "state",
       "entity_id": "switch.lemesh_cn_1124104134_sw3g01_on_p_2_1",
