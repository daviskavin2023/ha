       ],
       "then": [
        {
         "action": "switch.turn_off",
         "target": {
          "entity_id": "switch.lemesh_cn_1124104134_sw3g01_on_p_2_1"
         }
        }
       ]
      }
     ]
    }
   ]
  }
 ],
 "alias": "公卫关灯",
