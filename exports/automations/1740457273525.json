      },
      {
       "condition": "or",
       "conditions": [
        {
         "condition": "trigger",
         "id": "fan_max_timeout"
        },
        {
         "condition": "and",
         "conditions": [
          {
           "condition": "template",
           "value_template": "{{ (now() - states.binary_sensor.linp_cn_1130167279_hb01_occupancy_status_p_2_1.last_changed).total_seconds() >= 115 }}"
          },
          {
           "below": 70,
