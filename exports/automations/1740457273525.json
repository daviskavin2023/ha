         "entity_id": "switch.bean_cn_1124140333_blns2_on_p_3_1",
         "state": "on"
        }
       ],
       "then": [
        {
         "action": "switch.turn_off",
         "target": {
          "entity_id": "switch.bean_cn_1124140333_blns2_on_p_3_1"
         }
        }
       ]
      }
     ]
    },
    {
     "conditions": [
      {
