{
 "id": "yueyue_school_day_morning_alarm_0720",
 "alias": "悦悦房小爱音箱上学日起床闹钟 (07:20)",
 "description": "上学日每天早上 07:20：音箱静音执行指令（不播报人声），音量从极低缓慢渐强到 0.18，约 1 分钟后渐弱，最后平滑停止；全程约 2 分钟；2026-11-09：执行前校验音箱及指令可用性，失败写HA通知并标记错误；不把跳过不可用目标算成功",
 "triggers": [
  {
   "at": "07:20:00",
   "platform": "time"
  }
 ],
 "conditions": [
  {
   "condition": "state",
   "entity_id": "binary_sensor.shang_xue_ri",
   "state": "on"
  }
 ],
 "actions": [
  {
   "if": [
    {
     "condition": "template",
     "value_template": "{{ states('media_player.xiaomi_cn_981493908_l05b') in ['unavailable','unknown'] or states('notify.xiaomi_cn_981493908_l05b_execute_text_directive_a_5_4') in ['unavailable','unknown'] }}"
    }
   ],
   "then": [
    {
     "action": "persistent_notification.create",
     "data": {
      "notification_id": "yueyue_wakeup_unavailable",
      "title": "悦悦房叫醒未执行",
      "message": "07:20上学日叫醒已触发，但悦悦房小爱音箱或播放指令实体不可用。没有确认发声，请检查音箱供电、Wi-Fi及米家在线状态。"
     }
    },
    {
     "stop": "悦悦房音箱或播放指令不可用，叫醒未执行",
     "error": true
    }
   ]
  },
  {
   "action": "media_player.volume_mute",
   "data": {
    "is_volume_muted": false
   },
   "target": {
    "entity_id": "media_player.xiaomi_cn_981493908_l05b"
   }
  },
  {
   "action": "media_player.volume_set",
   "data": {
    "volume_level": 0.02
   },
   "target": {
    "entity_id": "media_player.xiaomi_cn_981493908_l05b"
   }
  },
  {
   "action": "notify.send_message",
   "data": {
    "message": "[\"播放轻音乐\", true]"
   },
   "target": {
    "entity_id": "notify.xiaomi_cn_981493908_l05b_execute_text_directive_a_5_4"
   }
  },
  {
   "delay": {
    "seconds": 5
   }
  },
  {
   "action": "media_player.volume_set",
   "data": {
    "volume_level": 0.04
   },
   "target": {
    "entity_id": "media_player.xiaomi_cn_981493908_l05b"
   }
  },
  {
   "delay": {
