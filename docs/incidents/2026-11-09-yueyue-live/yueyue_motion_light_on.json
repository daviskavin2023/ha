{
  "id": "yueyue_motion_light_on",
  "alias": "悦悦房人在感应开灯",
  "description": "悦悦房人在感应触发开灯(严格有人+暗光+未开防打扰)；23:00至次日10:00严禁感应开灯",
  "triggers": [
    {
      "platform": "state",
      "entity_id": "binary_sensor.linp_cn_blt_3_1qa5uknk4cg01_es2_occupancy_status_p_2_1078",
      "to": "on"
    },
    {
      "platform": "numeric_state",
      "entity_id": "sensor.linp_cn_blt_3_1qa5uknk4cg01_es2_illumination_p_2_1005",
      "below": 35
    },
    {
      "platform": "state",
      "entity_id": "sun.sun",
      "to": "below_horizon"
    }
  ],
  "conditions": [
    {
      "condition": "time",
      "after": "10:00:00",
      "before": "23:00:00"
    },
    {
      "condition": "state",
      "entity_id": "binary_sensor.linp_cn_blt_3_1qa5uknk4cg01_es2_occupancy_status_p_2_1078",
      "state": "on"
    },
    {
      "condition": "state",
      "entity_id": "input_boolean.yue_yue_fang_guan_deng_mo_shi",
      "state": "off"
    },
    {
      "condition": "state",
      "entity_id": "switch.bean_cn_1124139478_blns2_on_p_2_1",
      "state": "off"
    },
    {
      "condition": "or",
      "conditions": [
        {
          "condition": "state",
          "entity_id": "sun.sun",
          "state": "below_horizon"
        },
        {
          "condition": "numeric_state",
          "entity_id": "sensor.linp_cn_blt_3_1qa5uknk4cg01_es2_illumination_p_2_1005",
          "below": 35
        }
      ]
    }
  ],
  "actions": [
    {
      "action": "switch.turn_on",
      "target": {
        "entity_id": [
          "switch.bean_cn_1124139478_blns2_on_p_2_1",
          "switch.bean_cn_1124141619_blns1_on_p_2_1"
        ]
      }
    }
  ],
  "initial_state": true,
  "mode": "restart"
}
