{
  "id": "1736664474841",
  "alias": "客厅开灯",
  "description": "客厅有人且室内昏暗时自动开灯；支持雷达翻转、雷达接近事件即时触发；2026-11-10：客厅占用接入HB01+USB LD2410融合，失效不作无人；原场景门控和动作保留",
  "triggers": [
    {
      "platform": "state",
      "entity_id": "binary_sensor.ke_ting_shuang_lei_da_you_ren",
      "to": "on",
      "id": "radar_new_on",
      "from": "off"
    },
    {
      "platform": "state",
      "entity_id": "event.linp_cn_1130732284_hb01_approach_aloof_event_e_3_1",
      "id": "radar_approach_event"
    },
    {
      "platform": "state",
      "entity_id": "sun.sun",
      "to": "below_horizon",
      "id": "sunset"
    },
    {
      "platform": "numeric_state",
      "entity_id": "sensor.linp_cn_1130732284_hb01_illumination_p_2_5",
      "below": 50,
      "id": "dark_illumination"
    }
  ],
  "conditions": [
    {
      "condition": "state",
      "entity_id": "switch.bean_cn_1124140556_blns2_on_p_3_1",
      "state": "off"
    },
    {
      "condition": "state",
      "entity_id": "binary_sensor.ke_ting_shuang_lei_da_you_ren",
      "state": "on"
    },
    {
      "condition": "state",
      "entity_id": "input_boolean.ke_ting_guan_ying_mo_shi",
      "state": "off"
    },
    {
      "condition": "state",
      "entity_id": "binary_sensor.tou_ying_yi_zai_yong",
      "state": "off"
    },
    {
      "condition": "or",
      "conditions": [
        {
          "condition": "state",
          "entity_id": "sun.sun",
          "state": "below_horizon"
        },
        {
          "condition": "numeric_state",
          "entity_id": "sensor.linp_cn_1130732284_hb01_illumination_p_2_5",
          "below": 50
        }
      ]
    },
    {
      "condition": "numeric_state",
      "entity_id": "sensor.linp_cn_1130732284_hb01_illumination_p_2_5",
      "below": 85
    },
    {
      "condition": "state",
      "entity_id": "input_boolean.sheng_ri_mo_shi",
      "state": "off",
      "alias": "3051 生日中不动作"
    },
    {
      "condition": "template",
      "value_template": "{{ trigger.id != 'radar_approach_event' or (trigger.from_state is not none and trigger.to_state is not none and trigger.to_state.state not in ['unknown','unavailable'] and trigger.from_state.state != trigger.to_state.state and 0 <= (as_timestamp(now()) - as_timestamp(trigger.to_state.state,0)) <= 5) }}"
    }
  ],
  "actions": [
    {
      "choose": [
        {
          "conditions": [
            {
              "condition": "time",
              "after": "23:30:00",
              "before": "06:30:00"
            }
          ],
          "sequence": [
            {
              "action": "switch.turn_on",
              "target": {
                "entity_id": "switch.bean_cn_1124140065_blns2_on_p_2_1"
              }
            }
          ]
        }
      ],
      "default": [
        {
          "action": "switch.turn_on",
          "target": {
            "entity_id": "switch.bean_cn_1124140556_blns2_on_p_3_1"
          }
        }
      ]
    }
  ],
  "initial_state": true,
  "mode": "restart"
}
